# OPTIONAL. You do not need this file; install.sh asks for everything it needs
# interactively. Create it only for a fully unattended run:
#   cp .env.example .env && $EDITOR .env && ./install.sh --yes
#
# On a normal interactive run, install.sh WRITES this .env for you (with freshly
# generated secrets); you don't fill it in by hand. The values below are just
# to show what the installer will ask for. .env is git-ignored.

# --- What install.sh prompts for -------------------------------------------
N8N_DOMAIN=n8n.example.com        # domain (its DNS must point at this server)
N8N_BASE_PATH=/                   # '/' serves at the root (recommended); subpath is buggy
LETSENCRYPT_EMAIL=you@example.com # TLS registration / expiry-warning email
GENERIC_TIMEZONE=UTC              # e.g. Asia/Tehran, Europe/London
N8N_IMAGE_TAG=latest              # or pin, e.g. 1.70.0

# --- Secrets (install.sh generates these; set only for unattended installs) -
# Losing N8N_ENCRYPTION_KEY makes all stored credentials unrecoverable; keep it.
# N8N_ENCRYPTION_KEY=
# POSTGRES_PASSWORD=
