ps)\\\",\\n\\t\\t\\t\\t\\t\\\"this.state = {\\\",\\n\\t\\t\\t\\t\\t\\t\\\"${2}\\\",\\n\\t\\t\\t\\t\\t\\\"}\\\",\\n\\t\\t\\t\\t\\\"}\\\",\\n\\t\\t\\t\\n\\t\\t\\t\\t\\\"render() {\\\",\\n\\t\\t\\t\\t\\t\\\"return (\\\",\\n\\t\\t\\t\\t\\t\\t\\\"<div>\\\",\\n\\t\\t\\t\\t\\t\\t\\t\\\"${5}\\\",\\n\\t\\t\\t\\t\\t\\t\\\"</div>\\\",\\n\\t\\t\\t\\t\\t\\\");\\\",\\n\\t\\t\\t\\t\\\"}\\\",\\n\\t\\t\\t\\\"}\\\",\\n\\t\\t\\t\\t\\n\\t\\t\\t\\\"const mstp = (state) => ({\\\",\\n\\t\\t\\t\\t\\\"${3}\\\",\\n\\t\\t\\t\\\"});\\\",\\n\\n\\t\\t\\t\\\"export default connect(mstp)(${1});\\\"\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Make A React Component\\\"\\n\\t},\\n\\t\\\"Print to console.log\\\": {\\n\\t\\t\\\"prefix\\\": \\\"clog\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"console.log($1);\\\",\\n\\t\\t\\t\\\"$2\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t}\\n}\"}}","extensions":"[{\"identifier\":{\"id\":\"ahmad-einieh.python-packages-handler\",\"uuid\":\"5891255d-92a1-4421-bad5-db272e6b88c0\"},\"displayName\":\"Python Packages Handler\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ahmadalli.vscode-nginx-conf\",\"uuid\":\"9a97436d-76aa-479c-8ae9-db2f400a7b04\"},\"displayName\":\"NGINX Configuration Language Support\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"anthropic.claude-code\",\"uuid\":\"3c13ae49-babe-45fe-8c48-5e45077a62bf\"},\"displayName\":\"Claude Code for VS Code\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"aykutsarac.jsoncrack-vscode\",\"uuid\":\"87c9998f-5c0f-49ee-b89f-51340cdc449a\"},\"displayName\":\"JSON Crack\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"batisteo.vscode-django\",\"uuid\":\"4b41a5a8-170e-4156-b2c0-10efb270abbc\"},\"displayName\":\"Django\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"bradlc.vscode-tailwindcss\",\"uuid\":\"4db62a7c-7d70-419c-96d2-6c3a4dc77ea5\"},\"displayName\":\"Tailwind CSS IntelliSense\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"